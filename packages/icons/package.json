{
  "name": "@rough-lucide/icons",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/generated/index.js",
    "./icons/*": "./dist/generated/static/*.js",
    "./source/*": "./dist/generated/source/*.js",
    "./dynamic": "./dist/generated/dynamic-static.js",
    "./aliases": "./dist/generated/aliases.js",
    "./source/dynamic": "./dist/generated/dynamic-source.js",
    "./types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rough-lucide/core": "workspace:*"
  },
  "roughLucide": {
    "lucideSourceVersion": "1.33.0",
    "presetVersion": 1,
    "generatorVersion": 2
  }
}
